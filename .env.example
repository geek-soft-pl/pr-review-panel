# Organization whose pull requests the panel shows.
# Optional — if unset, falls back to the default hard-coded in src/App.tsx.
# Note: this value is baked into the built bundle (an org name is not secret).
VITE_GITHUB_ORG=geek-soft-pl

# There is intentionally NO token env var.
# Each user pastes their own GitHub token into the UI; it is kept in
# session/local storage and never embedded in the deployed bundle.
